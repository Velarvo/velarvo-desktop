{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "release-type": "go",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactoring" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true }
      ],
      "extra-files": [
        { "type": "generic", "path": "build/config.yml" },
        { "type": "generic", "path": "build/darwin/Info.plist" },
        { "type": "generic", "path": "build/darwin/Info.dev.plist" },
        { "type": "generic", "path": "build/linux/nfpm/nfpm.yaml" },
        { "type": "generic", "path": "build/windows/nsis/wails_tools.nsh" },
        {
          "type": "json",
          "path": "build/windows/info.json",
          "jsonpath": "$.fixed.file_version"
        },
        {
          "type": "json",
          "path": "build/windows/info.json",
          "jsonpath": "$.fixed.product_version"
        },
        {
          "type": "json",
          "path": "build/windows/info.json",
          "jsonpath": "$.info['0409'].FileVersion"
        },
        {
          "type": "json",
          "path": "build/windows/info.json",
          "jsonpath": "$.info['0409'].ProductVersion"
        }
      ]
    }
  }
}
