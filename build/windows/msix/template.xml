<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="velarvo"
        Arguments=""
        InstallLocation="C:\Program Files\Velarvo\Velarvo">
    </Installer>
    <PackageInformation
        PackageName="Velarvo"
        PackageDisplayName="Velarvo"
        PublisherName="CN=Velarvo"
        PublisherDisplayName="Velarvo"
        Version="0.1.0.0"
        PackageDescription="Developer workspace for SSH, SFTP, databases and APIs">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.velarvo.desktop"
                Description="Developer workspace for SSH, SFTP, databases and APIs"
                DisplayName="Velarvo"
                ExecutableName="velarvo"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Velarvo</DisplayName>
            <PublisherDisplayName>Velarvo</PublisherDisplayName>
            <Description>Developer workspace for SSH, SFTP, databases and APIs</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="velarvo.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
